[sub_resource type="Shader" id="dash_shader"]
code = "shader_type canvas_item;

// 1 px dashed rule in #3A4A60: 8 px dash, 6 px gap (14 px pitch) over a 576 px rule.
void fragment() {
	COLOR.rgb = vec3(0.227, 0.290, 0.376);
	COLOR.a *= step(fract(UV.x * 41.14), 0.571);
}"

